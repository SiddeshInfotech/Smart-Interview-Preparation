FROM ghcr.io/engineer-man/piston:latest

USER root

# Environment variables for Render cloud deployment
ENV PORT=2000
ENV DISABLE_SECURITY=true
ENV PISTON_JOBS_DIRECTORY=/tmp/jobs
ENV PISTON_PACKAGES_DIRECTORY=/tmp/packages
ENV PISTON_DATA_DIRECTORY=/tmp/piston

# 1. Create writable /tmp target directories
# 2. Symlink all possible isolate/jobs/packages paths across /piston to /tmp
# 3. Grant 777 permissions across /tmp and /piston during build phase
RUN mkdir -p /tmp/jobs /tmp/packages /tmp/piston /tmp/isolate && \
    chmod -R 777 /tmp && \
    mkdir -p /piston /piston/repo /piston/repo/api /piston/repo/api/src && \
    ln -sf /tmp/isolate /piston/isolate && \
    ln -sf /tmp/isolate /piston/repo/isolate && \
    ln -sf /tmp/isolate /piston/repo/api/isolate && \
    ln -sf /tmp/isolate /piston/repo/api/src/isolate && \
    ln -sf /tmp/jobs /piston/repo/jobs && \
    ln -sf /tmp/jobs /piston/repo/api/jobs && \
    ln -sf /tmp/packages /piston/repo/packages && \
    ln -sf /tmp/packages /piston/repo/api/packages && \
    chmod -R 777 /piston 2>/dev/null || true

# Maintain Piston's native base working directory (/piston/repo)
WORKDIR /piston/repo

EXPOSE 2000