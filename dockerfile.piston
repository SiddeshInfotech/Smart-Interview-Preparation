FROM node:18-alpine

# -----------------------------
# Install system dependencies
# -----------------------------
RUN apk add --no-cache \
    git \
    bash \
    python3 \
    make \
    g++ \
    curl \
    tar \
    xz \
    gzip \
    unzip

# -----------------------------
# Clone Piston
# -----------------------------
WORKDIR /opt

RUN git clone https://github.com/engineer-man/piston.git

# -----------------------------
# Install dependencies
# -----------------------------
WORKDIR /opt/piston/api
RUN npm install

WORKDIR /opt/piston/cli
RUN npm install

# -----------------------------
# Environment
# -----------------------------
ENV PORT=2000

ENV DISABLE_SECURITY=true
ENV PISTON_DISABLE_SECURITY=true

ENV PISTON_DATA_DIRECTORY=/var/data/piston
ENV PISTON_PACKAGES_DIRECTORY=/var/data/piston/packages
ENV PISTON_JOBS_DIRECTORY=/var/data/piston/jobs
ENV ISOLATE_HOME=/var/data/piston/isolate

# -----------------------------
# Writable directories
# -----------------------------
RUN mkdir -p \
    /var/data/piston/packages \
    /var/data/piston/jobs \
    /var/data/piston/isolate

RUN chmod -R 777 /var/data

# -----------------------------
# Install runtimes
# -----------------------------
WORKDIR /opt/piston

RUN node cli/index.js repo add pkgs https://github.com/engineer-man/piston.git
RUN node cli/index.js install python || true
RUN node cli/index.js install gcc || true
RUN node cli/index.js install java || true
RUN node cli/index.js install node || true
RUN node cli/index.js install go || true

# -----------------------------
# Debug
# -----------------------------
RUN echo "===== DATA ====="
RUN find /var/data -maxdepth 4

RUN echo "===== PACKAGES ====="
RUN find /var/data/piston/packages -maxdepth 4 || true

RUN echo "===== RUNTIMES ====="
RUN node cli/index.js list || true

# -----------------------------
# API
# -----------------------------
WORKDIR /opt/piston/api

EXPOSE 2000

CMD ["node","src/index.js"]