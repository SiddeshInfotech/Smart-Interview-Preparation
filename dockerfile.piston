FROM ghcr.io/engineer-man/piston:latest

USER root

ENV PORT=2000
ENV DISABLE_SECURITY=true

# Use writable directories
ENV PISTON_JOBS_DIRECTORY=/var/data/jobs
ENV PISTON_PACKAGES_DIRECTORY=/var/data/packages
ENV PISTON_DATA_DIRECTORY=/var/data/piston
ENV ISOLATE_HOME=/var/data/isolate

RUN mkdir -p \
    /var/data/jobs \
    /var/data/packages \
    /var/data/piston \
    /var/data/isolate

RUN chmod -R 777 /var/data/jobs \
    /var/data/packages \
    /var/data/piston \
    /var/data/isolate

WORKDIR /piston

CMD ["node", "api/src/index.js"]