# Production-Ready Piston API Deployment on Render (Built from Source)
FROM node:18-alpine

# Install build tools and dependencies
RUN apk add --no-cache git python3 make g++ bash cgroup-tools

WORKDIR /piston

# 1. Clone the official EngineerMan Piston repository from source
RUN git clone https://github.com/engineer-man/piston.git .

# 2. Install API & CLI dependencies
WORKDIR /piston/api
RUN npm install

WORKDIR /piston/cli
RUN npm install

# 3. Create writable storage directories (/var/data and /tmp fallbacks)
RUN mkdir -p /var/data/jobs /var/data/packages /var/data/piston /var/data/isolate \
             /tmp/jobs /tmp/packages /tmp/piston /tmp/isolate && \
    chmod -R 777 /var/data /tmp /piston

# 4. Configure Environment Variables as specified in plan
ENV PORT=2000
ENV DISABLE_SECURITY=true
ENV PISTON_JOBS_DIRECTORY=/var/data/jobs
ENV PISTON_PACKAGES_DIRECTORY=/var/data/packages
ENV PISTON_DATA_DIRECTORY=/var/data/piston
ENV ISOLATE_HOME=/var/data/isolate

WORKDIR /piston/api

EXPOSE 2000

# 5. Official Piston startup command
CMD ["node", "src/index.js"]