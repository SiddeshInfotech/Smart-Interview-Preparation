# Production-Ready Piston API Deployment on Render (Built from Source)
FROM node:18-alpine

# Install build tools and dependencies
RUN apk add --no-cache git python3 make g++ bash cgroup-tools curl

WORKDIR /piston

# 1. Clone the official EngineerMan Piston repository from source
RUN git clone https://github.com/engineer-man/piston.git .

# 2. Install API & CLI dependencies
WORKDIR /piston/api
RUN npm install

WORKDIR /piston/cli
RUN npm install

# 3. Create writable storage directories
RUN mkdir -p /piston/data/jobs /piston/data/packages /piston/data/isolate && \
    chmod -R 777 /piston /tmp

# 4. Configure Environment Variables
ENV PORT=2000
ENV DISABLE_SECURITY=true
ENV PISTON_DATA_DIRECTORY=/piston/data
ENV PISTON_PACKAGES_DIRECTORY=/piston/data/packages
ENV PISTON_JOBS_DIRECTORY=/piston/data/jobs
ENV DATA_DIRECTORY=/piston/data
ENV PACKAGES_DIRECTORY=/piston/data/packages
ENV JOBS_DIRECTORY=/piston/data/jobs
ENV ISOLATE_HOME=/piston/data/isolate

# 5. Pre-install specific runtime packages into the container image
WORKDIR /piston/cli
RUN node index.js install python 3.10.0
RUN node index.js install gcc 10.2.0
RUN node index.js install java 15.0.2
RUN node index.js install node 18.15.0
RUN node index.js install go 1.16.2

WORKDIR /piston/api

EXPOSE 2000

# 6. Ensure runtimes are installed on boot before starting API server
CMD ["sh", "-c", "for pkg in python gcc java node go; do node /piston/cli/index.js install $pkg || true; done; exec node src/index.js"]