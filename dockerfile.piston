FROM node:18-alpine

RUN apk add --no-cache git python3 make g++ bash curl tar xz gzip

WORKDIR /piston
RUN git clone https://github.com/engineer-man/piston.git .

WORKDIR /piston/api
RUN npm install

WORKDIR /piston/cli
RUN npm install

ENV PORT=2000
ENV DISABLE_SECURITY=true
ENV PISTON_DISABLE_SECURITY=true
ENV PISTON_DATA_DIRECTORY=/var/data/piston
ENV PISTON_JOBS_DIRECTORY=/var/data/jobs
ENV PISTON_PACKAGES_DIRECTORY=/var/data/packages
ENV ISOLATE_HOME=/var/data/isolate

RUN mkdir -p /var/data/piston /var/data/jobs /var/data/packages /var/data/isolate \
    && chmod -R 777 /var/data /piston

RUN node /piston/cli/index.js install python
RUN ls -R /var/data/piston
RUN node /piston/cli/index.js install gcc
RUN ls -R /var/data/piston
RUN node /piston/cli/index.js install java
RUN ls -R /var/data/piston
RUN node /piston/cli/index.js install node
RUN ls -R /var/data/piston
RUN node /piston/cli/index.js install go
RUN ls -R /var/data/piston

RUN ls -R /var/data || true

WORKDIR /piston/api
EXPOSE 2000
CMD ["node", "src/index.js"]